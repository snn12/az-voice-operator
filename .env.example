# ---------------------------------------------------------------------------
# AZ VOICE OPERATOR - environment template
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values locally.
# Never commit .env or any real credential.
# Every value below is a placeholder, not a working secret.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://az_voice:REPLACE_ME@localhost:5432/az_voice_operator

# Telephony / SIP trunk
SIP_TRUNK_HOST=
SIP_TRUNK_PORT=5060
SIP_USERNAME=
SIP_PASSWORD=

# Speech-to-text (hybrid providers - configure one or more later)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Text-to-speech
AZURE_TTS_VOICE=az-AZ-BanuNeural
AZURE_TTS_FALLBACK_VOICE=az-AZ-BabekNeural

# LLM provider
LLM_API_KEY=
LLM_MODEL=

# OpenAI Realtime (evaluation only until selected)
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
